<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Colors -->
    <SolidColorBrush x:Key="Primary" Color="#7656C9"/>
    <SolidColorBrush x:Key="PrimaryDark" Color="#5B3EAA"/>
    <SolidColorBrush x:Key="Navy" Color="#343746"/>
    <SolidColorBrush x:Key="Lavender" Color="#B9A5F5"/>
    <SolidColorBrush x:Key="LightLavender" Color="#F0EBFA"/>
    <SolidColorBrush x:Key="Purple" Color="#8C70D8"/>
    <SolidColorBrush x:Key="DarkPurple" Color="#49327F"/>
    <SolidColorBrush x:Key="Graphite" Color="#414453"/>
    <SolidColorBrush x:Key="Slate" Color="#626779"/>
    <SolidColorBrush x:Key="Silver" Color="#E2E4EB"/>
    <SolidColorBrush x:Key="Red" Color="#E87575"/>
    <SolidColorBrush x:Key="Background" Color="#F7F6FA"/>
    <SolidColorBrush x:Key="Text" Color="#343746"/>
    <SolidColorBrush x:Key="Border" Color="#DCD9E5"/>

    <!-- Global typography -->
    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="Background" Value="{StaticResource Background}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- Headings -->
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="Subheading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DarkPurple}"/>
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Graphite}"/>
    </Style>

    <!-- Input fields -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    </Style>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

</ResourceDictionary>
