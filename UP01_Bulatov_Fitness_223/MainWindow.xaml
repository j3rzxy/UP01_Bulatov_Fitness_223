<Window x:Class="UP01_Bulatov_Fitness_223.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP01_Bulatov_Fitness_223"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition>
            </RowDefinition>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Frame x:Name="MainFrame" 
            Grid.Row="1" 
            Source="Pages/AuthPage.xaml" 
            NavigationUIVisibility="Hidden" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Center" />
        <TextBlock x:Name="DateTimeNow"
                   HorizontalAlignment="Left"
                   Margin="650,15,0,0" Grid.Row="2"
                   VerticalAlignment="Top"
                   Width="140" 
                   Height="20"/>
        <Button x:Name="BackPageButton"
                Content="Назад"
                HorizontalAlignment="Left" 
                VerticalAlignment="Center" 
                Width="80" 
                Height="20" 
                Margin="10,0,0,0"/>
    </Grid>
</Window>
